<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updater_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/updater_title"
            android:textColor="#E5BA6B"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/installed_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9FBDAF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minLines="2"
            android:textColor="#E3EBD9"
            android:textSize="18sp"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:progressTint="#E5BA6B"
            android:progressBackgroundTint="#334C47"
            android:indeterminateTint="#E5BA6B"
            android:max="100" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/update_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:text="@string/updater_update"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#0E1A1A"
                android:backgroundTint="#E5BA6B" />
            <Button
                android:id="@+id/play_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="56dp"
                android:text="@string/updater_play"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#E3EBD9"
                android:backgroundTint="#334C47" />
            <Button
                android:id="@+id/retry_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="56dp"
                android:text="@string/updater_retry"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#E3EBD9"
                android:backgroundTint="#334C47" />
        </LinearLayout>
        <Button
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/updater_cancel"
            android:textAllCaps="false"
            android:textColor="#E3EBD9"
            android:backgroundTint="#142626"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/updater_help"
            android:textColor="#9FBDAF"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
