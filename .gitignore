!/artifacts/observer-native.png
!/artifacts/geography-map.png
!/artifacts/geography-ground.png

# Machine-local configuration, credentials, and editor/OS debris.
.env
.env.*
!.env.example
*.log
*.rs.bk
__pycache__/
.DS_Store
Thumbs.db
/.idea/
/.vscode/
