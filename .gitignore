# Local compilation and persistent worlds (Cargo.lock is intentionally tracked).
/target/
/saves/

# Keep only the curated screenshots linked from the project documentation.
/artifacts/*
!/artifacts/prototype.png
!/artifacts/two-client.png
!/artifacts/restarted-world.png
!/artifacts/shadows-balanced.png
!/artifacts/shadows-low.png
!/artifacts/shadows-high.png
